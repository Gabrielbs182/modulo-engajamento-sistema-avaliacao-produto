# Copie para .env.local e preencha. O .env.local não vai para o git.
# Os valores ficam no painel do Supabase: Project Settings → API Keys / Data API.

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave SECRETA (sb_secret_...) ou a service_role legada. Ignora o RLS: só o servidor
# usa, por isso não tem o prefixo NEXT_PUBLIC_ e nunca chega ao navegador.
SUPABASE_SECRET_KEY=
